# Open WebUI configuration
# See https://docs.openwebui.com/getting-started/env-configuration for all options
PORT=8080
DATA_DIR=/var/lib/open-webui

# Remote Ollama (optional). Use http://127.0.0.1:11434 when using an SSH tunnel.
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional: set a fixed secret key. If unset, open-webui serve generates
# /opt/open-webui/.webui_secret_key on first start.
# WEBUI_SECRET_KEY=
